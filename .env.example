# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP configuration for forwarding wholesale contact inquiries to info.buttervalley@gmail.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECIPIENT_EMAIL="info.buttervalley@gmail.com"

# Optional confirmed phone/WhatsApp contact details (configure once client confirms number)
VITE_CONTACT_PHONE=""
VITE_CONTACT_WHATSAPP=""

# EmailJS configuration overrides for Contact Us & Request Quote forms
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
